# TradeDesk configuration — copy to .env and edit.  (cp .env.example .env)
# Every value has a sensible default; with no .env at all the app runs on the simulator.

# ------------------------------------------------------------------ data source
# sim  = built-in market simulator (byte-identical Dhan packets, no account needed)
# dhan = live Dhan Data API
DATA_SOURCE=sim

# Dhan credentials: web.dhan.co -> My Profile -> Access DhanHQ APIs -> generate token.
# Tokens expire (typically 24 h) — paste a fresh one and restart the ingestor.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# basic = ₹499 Data APIs plan  -> live feed, 20-level depth, option chain, history
# pro   = ₹999 Pro Traders plan -> + news headlines, market movers, CAS (closing auction) feed, 200-level depth
DHAN_PLAN=pro

# Published limits — only change if Dhan changes them.
LIMIT_DATA_PER_SEC=5
LIMIT_DATA_PER_DAY=7000
LIMIT_QUOTE_PER_SEC=1
LIMIT_CHAIN_UNIQUE_PER_8S=10

# Live mode: pull what the desks need from Dhan's historical API at start-up and every day at 08:40 IST —
# previous close (stocks + indices), yesterday's futures OI, ~1 year of daily bars, 30 days of 1-minute
# bars, and today's 1-minute bars when started late. Incremental; ~750 calls the first time, ~400/day after.
AUTO_HISTORY=true
AUTO_HISTORY_DAYS=400

# ------------------------------------------------------------------ infrastructure
REDIS_URL=redis://localhost:6379/0
# Tick stream buffer (batches of 100 ms). Transport only — history lives in data/recorder.
STREAM_MAXLEN=1500
# Lake, recorder, scorecards, research output, ranker weights
# DATA_DIR=/absolute/path/to/data   (default: <project>/data)

# ------------------------------------------------------------------ universe
# fno    = every F&O stock (+ near-month futures + NIFTY/BANKNIFTY/FINNIFTY/MIDCPNIFTY/VIX)
# custom = only the SYMBOLS below (comma separated NSE symbols)
UNIVERSE=fno
SYMBOLS=
# Option chains refreshed every ~15 s (Dhan: 1 request / 3 s per underlying+expiry)
CHAIN_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY

# ------------------------------------------------------------------ simulator
SIM_SPEED=1          # 1 = real time, 20 = a whole session in ~19 minutes
SIM_START=09:13:30   # simulated IST start time (pre-open -> open -> 09:30 lock -> close)
SIM_SEED=0           # 0 = a new random day on each start; any other number replays the same day
SIM_SYMBOLS=180

# ------------------------------------------------------------------ strategy
TOP_N=5
LOCK_TIME=09:30:00   # picks lock here and are tracked to the close
OR_MINUTES=15        # opening range length
MIN_TURNOVER_CR=5    # liquidity filter: ₹ crore traded by the lock

# ------------------------------------------------------------------ GEO desk (F7, world events)
GEO_ENABLED=true
# auto = simulated world feeds when DATA_SOURCE=sim, real feeds when DATA_SOURCE=dhan; or force live / sim
GEO_SOURCE=auto
# Free keys (each takes a minute to get). Without them those two views show NEEDS KEY; everything else works.
AISSTREAM_API_KEY=           # aisstream.io -> live ship positions
FIRMS_MAP_KEY=               # firms.modaps.eosdis.nasa.gov/api/map_key -> satellite fire hotspots
FRED_API_KEY=                # optional (fred.stlouisfed.org); the CSV download works without one
ADSB_API_URL=https://api.adsb.lol    # or https://api.airplanes.live (same format)
# Sources the host never polls: ships,air,conflict,fires,chokepoints,risk,macro
GEO_DISABLE=
GEO_GDELT_BACKFILL_HOURS=12  # conflict history pulled at start-up
GEO_TO_NEWS=false            # true = severe geo signals also feed the NEWS desk and the ranker's catalyst factor
# Near-month MCX / NSE currency futures shown live on the GEO desk (Dhan feed)
GEO_MACRO_SYMBOLS=CRUDEOIL,NATURALGAS,GOLD,SILVER,USDINR

# ------------------------------------------------------------------ gateway / sharing
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Private sharing: comma-separated name:key pairs. Empty = no key needed (fine on localhost only).
# Friends open  http://<your-address>:8000/?key=<their key>
ACCESS_KEYS=
# Accounts and the admin page (http://<host>:8000/admin: users, 5-year history pulls, system health).
# With no accounts the terminal is open, as before. The first admin is created from these two if that user
# does not exist yet (needed with Docker or a remote server). Without them, open http://localhost:8000/login
# on the host itself to create it. Once any account exists, everyone logs in (share-link keys still work).
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_DAYS=30              # how long a login lasts
# SESSION_SECRET=            # signing key for logins; default: generated in data/auth/secret.key
CORS_ORIGINS=*
